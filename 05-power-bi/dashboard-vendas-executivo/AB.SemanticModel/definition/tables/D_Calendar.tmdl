	column EhUltimoDiaMes
		formatString: 0
		lineageTag: ffd9aa81-6236-42fd-89ed-a5c74e32368c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [EhUltimoDiaMes]

		annotation SummarizationSetBy = Automatic

	partition D_Calendario = calculated
		mode: import
		source = ```
				
				VAR DataInicial =
				    CALCULATE (
				        MIN ( F_Orders[order_date] ),
				        ALL ( F_Orders )
				    )
				
				VAR DataFinal =
				    CALCULATE (
				        MAX ( F_Orders[order_date] ),
				        ALL ( F_Orders )
				    )
				
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DataInicial, DataFinal ),
				
				    // === Year / Month ===
				    "Ano", YEAR ( [Date] ),
				    "Mês Num", MONTH ( [Date] ),
				    "Mês Abrev", FORMAT ( [Date], "MMM", "en-US" ),
				    "Mês Nome", FORMAT ( [Date], "MMMM", "en-US" ),
				
				    // === Year-Month ===
				    "AnoMes", FORMAT ( [Date], "YYYYMM" ),
				    "MesAnoNome", FORMAT ( [Date], "MMMM YYYY", "en-US" ),
				    "AnoMesNum", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				
				    // === Quarter ===
				    "Trim", FORMAT ( [Date], "q" ),
				    "AnoTrimestre", YEAR ( [Date] ) * 10 + QUARTER ( [Date] ),
				
				    // === Week ===
				    "Semana Ano", WEEKNUM ( [Date] ),
				    "AnoSemana", YEAR ( [Date] ) * 100 + WEEKNUM ( [Date], 2 ),
				
				    // === ISO Week ===
				    "ISO_Semana", WEEKNUM ( [Date], 21 ),
				    "ISO_Ano", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				    "ISO_AnoSemana",
				        ( YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ) * 100 )
				        + WEEKNUM ( [Date], 21 ),
				
				    // === Day ===
				    "Dia do Mês", DAY ( [Date] ),
				    "Dia Semana", WEEKDAY ( [Date] ),
				    "DiaSemanaNumero", WEEKDAY ( [Date], 2 ),
				    "DiaSemanaNome", FORMAT ( [Date], "dddd", "en-US" ),
				
				    // === Day-Month ===
				    "DiaMes", FORMAT ( [Date], "dd/MM" ),
				    "DiaMesTexto", FORMAT ( [Date], "dd MMMM", "en-US" ),
				    "DiaMesNomeCurto", FORMAT ( [Date], "dd MMM", "en-US" ),
				    "DiaMesNumero", MONTH ( [Date] ) * 100 + DAY ( [Date] ),
				    "DiaMesComAno", FORMAT ( [Date], "dd/MM/yyyy" ),
				
				    // === Flags ===
				    "EhFimDeSemana", IF ( WEEKDAY ( [Date], 2 ) >= 6, 1, 0 ),
				    "EhDiaUtil", IF ( WEEKDAY ( [Date], 2 ) <= 5, 1, 0 ),
				
				    // === Period start/end ===
				    "InicioDoMes", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ),
				    "FimDoMes", EOMONTH ( [Date], 0 ),
				
				    "InicioDoTrimestre",
				        DATE (
				            YEAR ( [Date] ),
				            ( QUARTER ( [Date] ) * 3 ) - 2,
				            1
				        ),
				
				    "FimDoTrimestre",
				        EOMONTH (
				            DATE (
				                YEAR ( [Date] ),
				                QUARTER ( [Date] ) * 3,
				                1
				            ),
				            0
				        ),
				
				    "InicioDoAno", DATE ( YEAR ( [Date] ), 1, 1 ),
				    "FimDoAno", DATE ( YEAR ( [Date] ), 12, 31 ),
				
				    // === Closing flags ===
				    "EhPrimeiroDiaMes",
				        IF ( [Date] = DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), 1, 0 ),
				
				    "EhUltimoDiaMes",
				        IF ( [Date] = EOMONTH ( [Date], 0 ), 1, 0 )
				)
				
				```

	annotation PBI_Id = 89b03f08e71f4188a4c8d8ac57cce3e1

