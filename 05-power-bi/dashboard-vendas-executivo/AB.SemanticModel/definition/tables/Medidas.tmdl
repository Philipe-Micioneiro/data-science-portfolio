	measure 'Narr P4 Ticket' = "The portfolio's average ticket is " & FORMAT([Average Ticket], "R$ #,##0.00", "en-US") & " per order."
		displayFolder: 09 Narrativa P4 Carteira
		lineageTag: 2e207590-42e9-43f0-8aab-3fcff6ac5ac1

	measure 'Narr P5 Concentracao' = "Critical concentration: the top 2 clients account for " & FORMAT([Top 2 Clients Share], "0.0%", "en-US") & " of total revenue — the portfolio depends on very few accounts."
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: 28b8f445-f113-4043-920e-fb61227da658

	measure 'Narr P5 BeyondBeer' = "Beyond Beer accounts for " & FORMAT([% Beyond Beer Share], "0.0%", "en-US") & " of revenue exposure, yet no product from these categories reaches the Top 5."
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: a7b490a0-56e5-40f4-8768-689f62ac2fb4

	measure 'Narr P5 Auditoria' = "Data audit: a naive sum of revenue would reach " & FORMAT([Raw Revenue No Dedup], "R$ #,##0.00", "en-US") & ", corrected to " & FORMAT([Total Revenue], "R$ #,##0.00", "en-US") & " via order-level deduplication."
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: e8f07500-6870-479d-bca0-57ebb71dcc2d

	measure 'Narr P5 Escala' = "Scale note: " & FORMAT([Active Clients], "0", "en-US") & " clients and " & FORMAT([Order Count], "#,##0", "en-US") & " orders — the model is ready to scale without structural changes."
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: fd9ed340-76e4-4d77-9cc0-2aae9220463a

	/// Se um mês específico estiver selecionado (slicer, linha de tabela/gráfico por mês), calcula o MoM daquele mês. Se nenhum mês estiver selecionado, usa o último mês disponível dentro do que estiver filtrado (ano/cidade/categoria). Use esta no card executivo da Página 1.
	measure 'MoM (Último Mês)' =
			IF(
			    HASONEVALUE(D_Calendar[Year Month Number]),
			    [Month-over-month growth (%)],
			    VAR LastMonthInContext =
			        CALCULATE(
			            MAX(D_Calendar[Year Month Number]),
			            ALLSELECTED(D_Calendar)
			        )
			    RETURN
			        CALCULATE(
			            [Month-over-month growth (%)],
			            D_Calendar[Year Month Number] = LastMonthInContext
			        )
			)
		formatString: 0.0%;-0.0%
		displayFolder: 01 KPIs Principais
		lineageTag: 24d7fc7b-6d84-44a8-98f8-ab8d8ff91a1f

	measure 'Narr P1 Full' = [Narr P1 Faturamento] & UNICHAR(10) & UNICHAR(10) & [Narr P1 Crescimento] & UNICHAR(10) & UNICHAR(10) & [Narr P1 YTD] & UNICHAR(10) & UNICHAR(10) & [Narr P1 Meta] & UNICHAR(10) & UNICHAR(10) & [Narr P1 Operacao]
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: 9d13f807-609d-476a-b7c6-a84fe33bcc6a

	measure 'Narr P2 Full' = [Narr P2 MelhorMes] & UNICHAR(10) & UNICHAR(10) & [Narr P2 PiorMes] & UNICHAR(10) & UNICHAR(10) & [Narr P2 Consistency] & UNICHAR(10) & UNICHAR(10) & [Narr P2 YTD]
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: c3f7bea6-25bf-4b56-bc1e-1f986f781506

	measure 'Narr P3 Full' = [Narr P3 Categoria] & UNICHAR(10) & UNICHAR(10) & [Narr P3 Mix] & UNICHAR(10) & UNICHAR(10) & [Narr P3 BeyondBeer] & UNICHAR(10) & UNICHAR(10) & [Narr P3 TopSKU]
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: aea9faa0-66e6-41fe-bf92-dce52dbb3ddf

	measure 'Narr P4 Full' = [Narr P4 Segmento] & UNICHAR(10) & UNICHAR(10) & [Narr P4 Cidade] & UNICHAR(10) & UNICHAR(10) & [Narr P4 Geography] & UNICHAR(10) & UNICHAR(10) & [Narr P4 Meta] & UNICHAR(10) & UNICHAR(10) & [Narr P4 Ticket]
		displayFolder: 09 Narrativa P4 Carteira
		lineageTag: 9a1d1be2-d42a-4d5c-8565-adff6f401cab

	measure 'Narr P5 Full' =
			VAR NL = UNICHAR(10) & UNICHAR(10)
			RETURN
			"KEY FINDINGS" & NL &
			"• Revenue is highly concentrated: the top 2 clients account for " & FORMAT([Top 2 Clients Share],"0.0%","en-US") & " of total revenue — the portfolio depends on very few accounts." & NL &
			"• Beer dominates the portfolio; Beyond Beer reaches " & FORMAT([% Beyond Beer Share],"0.0%","en-US") & " of revenue exposure, yet no product from these categories reaches the Top 5." & NL &
			"• Performance is volatile month to month: the strongest month was " & [Best Month Name] & " (" & FORMAT([Best Month Revenue],"R$ #,##0","en-US") & "), while the sharpest drop was " & [Worst MoM Month Name] & " (" & FORMAT([Worst MoM Value],"0.0%","en-US") & ")." & NL &
			"• Only " & FORMAT([Clients On Target Count],"0","en-US") & " of " & FORMAT([Active Clients],"0","en-US") & " clients are meeting their monthly target, leaving a combined gap of " & FORMAT([Target Gap Amount],"R$ #,##0","en-US") & " to close." & NL &
			"RECOMMENDATIONS" & NL &
			"• Prioritize clients closest to their target first — the fastest path to closing the " & FORMAT([Target Gap Amount],"R$ #,##0","en-US") & " gap is converting near-misses, not chasing the furthest accounts." & NL &
			"• Reduce dependency on the top 2 accounts by developing the next tier through BEES — losing either one would remove close to " & FORMAT([Top 2 Clients Share],"0%","en-US") & " of revenue overnight." & NL &
			"• Test Beyond Beer bundling with the highest-ticket clients to grow basket size without acquiring new accounts." & NL &
			"FUTURE RESEARCH OPPORTUNITIES" & NL &
			"• Item-level pricing and quantity data for a true market basket analysis and SKU-level revenue split." & NL &
			"• Cost and margin (COGS) data to validate the Beyond Beer margin thesis." & NL &
			"• Multi-year history to separate real seasonality from single-year noise." & NL &
			"• Local market potential data per client to explain target variance." & NL &
			"• Product category × client segment cross-analysis once the client base supports that granularity." & NL &
			"• Validate whether the " & FORMAT([Top 2 Clients Share],"0.0%","en-US") & " concentration holds as the portfolio grows." & NL &
			"METHODOLOGY & SCOPE" & NL &
			"• Data audit: a naive sum of revenue would reach " & FORMAT([Raw Revenue No Dedup],"R$ #,##0.00","en-US") & ", corrected to " & FORMAT([Total Revenue],"R$ #,##0.00","en-US") & " via order-level deduplication." & NL &
			"• Scale note: based on " & FORMAT([Active Clients],"0","en-US") & " clients and " & FORMAT([Order Count],"#,##0","en-US") & " orders across " & FORMAT([Months In Context],"0","en-US") & " months — the model is ready to scale without structural changes."
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: 3eb6ec68-9e36-48ca-9550-f08890a5f61f

	measure 'Narr P1 HTML' = ```
			
			VAR TitleText = "Dynamic Insights"
			VAR FontSize = 15
			VAR Spacing = 16
			VAR ShowBullet = TRUE
			VAR TextColor = "#D1D5DB"
			VAR AccentColor = "#E0AE55"
			VAR BadgeBg = "rgba(224, 174, 85, 0.18)"
			VAR TitleColor = "#9CA3AF"
			
			VAR TitleStyle = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px 0;'"
			VAR PStyle = "style='color:" & TextColor & ";font-size:" & FontSize & "px;margin:0 0 " & Spacing & "px 0;line-height:1.6;display:flex;align-items:baseline;'"
			VAR Hi = "style='color:" & AccentColor & ";background-color:" & BadgeBg & ";font-size:" & FontSize & "px;font-weight:700;padding:2px 7px;border-radius:4px;display:inline-block;margin:0 2px;'"
			VAR Bullet = IF(ShowBullet, "<span style='color:" & AccentColor & ";font-size:" & (FontSize + 2) & "px;margin-right:10px;line-height:1;'>&#8226;</span>", "")
			
			RETURN
			"<div " & TitleStyle & ">" & TitleText & "</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>Total revenue for the period is <span " & Hi & ">" & FORMAT([Total Revenue],"R$ #,##0","en-US") & "</span>, with an average ticket of <span " & Hi & ">" & FORMAT([Average Ticket],"R$ #,##0","en-US") & "</span> per order.</span></p>" & 
			"<p " & PStyle & ">" & Bullet & "<span>Month-over-month growth is at <span " & Hi & ">" & FORMAT([MoM (Último Mês)],"0.0%","en-US") & "</span>.</span></p>" & 
			"<p " & PStyle & ">" & Bullet & "<span>Year-to-date revenue reaches <span " & Hi & ">" & FORMAT([Year-to-date revenue],"R$ #,##0","en-US") & "</span>.</span></p>" & 
			"<p " & PStyle & ">" & Bullet & "<span>The portfolio reached <span " & Hi & ">" & FORMAT([% Target Achievement],"0.0%","en-US") & "</span> of the monthly target, with <span " & Hi & ">" & FORMAT([Clients Below Target Count],"0","en-US") & "</span> clients still below objective.</span></p>" & 
			"<p " & PStyle & ">" & Bullet & "<span>The operation counts <span " & Hi & ">" & FORMAT([Active Clients],"0","en-US") & "</span> active clients and <span " & Hi & ">" & FORMAT([Order Count],"#,##0","en-US") & "</span> orders processed.</span></p>"
			```
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: 236cfb12-f68b-4c2e-b9eb-6a5999d8ee23

	measure 'Narr P2 HTML' =
			VAR TitleText = "Time Trend Insights"
			VAR FontSize = 15
			VAR Spacing = 16
			VAR ShowBullet = TRUE
			VAR TextColor = "#D1D5DB"
			VAR AccentColor = "#E0AE55"
			VAR BadgeBg = "rgba(224, 174, 85, 0.18)"
			VAR TitleColor = "#9CA3AF"
			
			VAR TitleStyle = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px 0;'"
			VAR PStyle = "style='color:" & TextColor & ";font-size:" & FontSize & "px;margin:0 0 " & Spacing & "px 0;line-height:1.6;display:flex;align-items:baseline;'"
			VAR Hi = "style='color:" & AccentColor & ";background-color:" & BadgeBg & ";font-size:" & FontSize & "px;font-weight:700;padding:2px 7px;border-radius:4px;display:inline-block;margin:0 2px;'"
			VAR Bullet = IF(ShowBullet, "<span style='color:" & AccentColor & ";font-size:" & (FontSize + 2) & "px;margin-right:10px;line-height:1;'>&#8226;</span>", "")
			
			RETURN
			"<div " & TitleStyle & ">" & TitleText & "</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>The best-performing month was <span " & Hi & ">" & [Best Month Name] & "</span>, with revenue of <span " & Hi & ">" & FORMAT([Best Month Revenue],"R$ #,##0.00","en-US") & "</span>.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>The largest month-over-month drop occurred in <span " & Hi & ">" & [Worst MoM Month Name] & "</span>, with a decline of <span " & Hi & ">" & FORMAT([Worst MoM Value],"0.0%","en-US") & "</span>.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Growth was inconsistent across the year: only <span " & Hi & ">" & FORMAT([Positive MoM Months],"0","en-US") & " of " & FORMAT([Positive MoM Months] + [Negative MoM Months],"0","en-US") & "</span> comparable months showed growth, declines outnumbering gains <span " & Hi & ">" & FORMAT([Negative MoM Months],"0","en-US") & " to " & FORMAT([Positive MoM Months],"0","en-US") & "</span>.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Year-to-date revenue represents <span " & Hi & ">" & FORMAT([Year-to-date revenue],"R$ #,##0.00","en-US") & "</span> — use the controls alongside to switch between absolute and percentage views.</span></p>"
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: 92abc91a-d82c-47cc-9a4d-773a3afc1d6e

	measure 'Narr P3 HTML' =
			VAR TitleText = "Portfolio Insights"
			VAR FontSize = 15
			VAR Spacing = 16
			VAR ShowBullet = TRUE
			VAR TextColor = "#D1D5DB"
			VAR AccentColor = "#E0AE55"
			VAR BadgeBg = "rgba(224, 174, 85, 0.18)"
			VAR TitleColor = "#9CA3AF"
			
			VAR TitleStyle = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px 0;'"
			VAR PStyle = "style='color:" & TextColor & ";font-size:" & FontSize & "px;margin:0 0 " & Spacing & "px 0;line-height:1.6;display:flex;align-items:baseline;'"
			VAR Hi = "style='color:" & AccentColor & ";background-color:" & BadgeBg & ";font-size:" & FontSize & "px;font-weight:700;padding:2px 7px;border-radius:4px;display:inline-block;margin:0 2px;'"
			VAR Bullet = IF(ShowBullet, "<span style='color:" & AccentColor & ";font-size:" & (FontSize + 2) & "px;margin-right:10px;line-height:1;'>&#8226;</span>", "")
			
			RETURN
			"<div " & TitleStyle & ">" & TitleText & "</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>The <span " & Hi & ">" & [Leading Product Category] & "</span> category leads portfolio revenue.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Beyond Beer's growth is really a NAB story: non-alcoholic alone represents <span " & Hi & ">" & FORMAT([NAB Share %],"0.0%","en-US") & "</span> of revenue exposure, while liquor and soda combined stay under <span " & Hi & ">" & FORMAT([Liquor Soda Share %],"0.0%","en-US") & "</span>.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Beyond Beer categories account for <span " & Hi & ">" & FORMAT([% Beyond Beer Share],"0.0%","en-US") & "</span> of revenue — the BEES strategic diversification frontier.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>The top-earning SKU is product <span " & Hi & ">" & FORMAT([Top Product ID],"0","en-US") & "</span>, featured in the period's Top 5.</span></p>"
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: c66d8d62-5d08-4791-b195-1f1c3dcf6509

	measure 'Narr P4 HTML' =
			VAR TitleText = "Customer Insights"
			VAR FontSize = 15
			VAR Spacing = 16
			VAR ShowBullet = TRUE
			VAR TextColor = "#D1D5DB"
			VAR AccentColor = "#E0AE55"
			VAR BadgeBg = "rgba(224, 174, 85, 0.18)"
			VAR TitleColor = "#9CA3AF"
			
			VAR TitleStyle = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px 0;'"
			VAR PStyle = "style='color:" & TextColor & ";font-size:" & FontSize & "px;margin:0 0 " & Spacing & "px 0;line-height:1.6;display:flex;align-items:baseline;'"
			VAR Hi = "style='color:" & AccentColor & ";background-color:" & BadgeBg & ";font-size:" & FontSize & "px;font-weight:700;padding:2px 7px;border-radius:4px;display:inline-block;margin:0 2px;'"
			VAR Bullet = IF(ShowBullet, "<span style='color:" & AccentColor & ";font-size:" & (FontSize + 2) & "px;margin-right:10px;line-height:1;'>&#8226;</span>", "")
			
			RETURN
			"<div " & TitleStyle & ">" & TitleText & "</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>The <span " & Hi & ">" & [Leading Client Category] & "</span> segment generates the most revenue in the portfolio.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>The city with the highest revenue is <span " & Hi & ">" & [Leading City] & "</span>.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span><span " & Hi & ">" & [Leading City] & "</span>'s lead is driven largely by a single client: its top account alone represents <span " & Hi & ">" & FORMAT([Leading City Top Client Share %],"0.0%","en-US") & "</span> of the city's total revenue.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span><span " & Hi & ">" & FORMAT([Clients Below Target Count],"0","en-US") & "</span> clients are below 100% of their monthly target — a direct commercial action opportunity via BEES.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>The portfolio's average ticket is <span " & Hi & ">" & FORMAT([Average Ticket],"R$ #,##0.00","en-US") & "</span> per order.</span></p>"
		displayFolder: 09 Narrativa P4 Carteira
		lineageTag: 7cabdf5e-980b-462f-9860-b59a3f19dfc0

	measure 'Narr P5 HTML' =
			VAR FontSize = 15
			VAR Spacing = 16
			VAR ShowBullet = TRUE
			VAR TextColor = "#D1D5DB"
			VAR AccentColor = "#E0AE55"
			VAR BadgeBg = "rgba(224, 174, 85, 0.18)"
			VAR TitleColor = "#9CA3AF"
			VAR PStyle = "style='color:" & TextColor & ";font-size:" & FontSize & "px;margin:0 0 " & Spacing & "px 0;line-height:1.6;display:flex;align-items:baseline;'"
			VAR Hi = "style='color:" & AccentColor & ";background-color:" & BadgeBg & ";font-size:" & FontSize & "px;font-weight:700;padding:2px 7px;border-radius:4px;display:inline-block;margin:0 2px;'"
			VAR TitleStyle = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:24px 0 18px 0;'"
			VAR TitleStyleFirst = "style='color:" & TitleColor & ";font-size:13px;font-weight:700;letter-spacing:1px;text-transform:uppercase;margin:0 0 18px 0;'"
			VAR Bullet = IF(ShowBullet, "<span style='color:" & AccentColor & ";font-size:" & (FontSize + 2) & "px;margin-right:10px;line-height:1;'>&#8226;</span>", "")
			RETURN
			"<div " & TitleStyleFirst & ">Key Findings</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>Revenue is highly concentrated: the top 2 clients account for <span " & Hi & ">" & FORMAT([Top 2 Clients Share],"0.0%","en-US") & "</span> of total revenue — the portfolio depends on very few accounts.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Beer dominates the portfolio; Beyond Beer reaches <span " & Hi & ">" & FORMAT([% Beyond Beer Share],"0.0%","en-US") & "</span> of revenue exposure, yet no product from these categories reaches the Top 5.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Performance is volatile month to month: the strongest month was <span " & Hi & ">" & [Best Month Name] & "</span> (<span " & Hi & ">" & FORMAT([Best Month Revenue],"R$ #,##0","en-US") & "</span>), while the sharpest drop was <span " & Hi & ">" & [Worst MoM Month Name] & "</span> (<span " & Hi & ">" & FORMAT([Worst MoM Value],"0.0%","en-US") & "</span>).</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Only <span " & Hi & ">" & FORMAT([Clients On Target Count],"0","en-US") & " of " & FORMAT([Active Clients],"0","en-US") & "</span> clients are meeting their monthly target, leaving a combined gap of <span " & Hi & ">" & FORMAT([Target Gap Amount],"R$ #,##0","en-US") & "</span> to close.</span></p>" &
			"<div " & TitleStyle & ">Recommendations</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>Prioritize clients closest to their target first — the fastest path to closing the <span " & Hi & ">" & FORMAT([Target Gap Amount],"R$ #,##0","en-US") & "</span> gap is converting near-misses, not chasing the furthest accounts.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Reduce dependency on the top 2 accounts by developing the next tier through BEES — losing either one would remove close to <span " & Hi & ">" & FORMAT([Top 2 Clients Share],"0%","en-US") & "</span> of revenue overnight.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Test Beyond Beer bundling with the highest-ticket clients to grow basket size without acquiring new accounts — the category is already present in a third of order value, just not concentrated in single high-ticket SKUs.</span></p>" &
			"<div " & TitleStyle & ">Future Research Opportunities</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>Item-level pricing and quantity data would allow a true market basket analysis and a revenue split by SKU without the order-level duplication caveat noted below.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Cost and margin (COGS) data would validate whether Beyond Beer actually carries a better margin than beer — the core assumption behind the diversification strategy.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Multi-year history would separate real seasonality from single-year noise and enable a genuine year-over-year comparison.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Local market potential data per client would explain why monthly targets range so widely across the portfolio, and whether they are calibrated correctly.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>A product category × client segment cross-analysis would show which channels drive Beyond Beer adoption — worth revisiting once the client base is large enough to support that granularity without sparse, unreliable cells.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Validate whether the <span " & Hi & ">" & FORMAT([Top 2 Clients Share],"0.0%","en-US") & "</span> concentration in 2 clients holds as the portfolio grows, or whether it is an artifact of this small sample.</span></p>" &
			"<div " & TitleStyle & ">Methodology &amp; Scope</div>" &
			"<p " & PStyle & ">" & Bullet & "<span>Data audit: a naive sum of revenue would reach <span " & Hi & ">" & FORMAT([Raw Revenue No Dedup],"R$ #,##0.00","en-US") & "</span>, corrected to <span " & Hi & ">" & FORMAT([Total Revenue],"R$ #,##0.00","en-US") & "</span> via order-level deduplication — every number above reflects this correction.</span></p>" &
			"<p " & PStyle & ">" & Bullet & "<span>Scale note: this reading is based on <span " & Hi & ">" & FORMAT([Active Clients],"0","en-US") & "</span> clients and <span " & Hi & ">" & FORMAT([Order Count],"#,##0","en-US") & "</span> orders across <span " & Hi & ">" & FORMAT([Months In Context],"0","en-US") & "</span> months — enough for a strategic read, and the model is ready to scale without structural changes.</span></p>"
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: 0e21d005-f7dc-4c31-ab93-4d19e3bfcf39

	measure Velocimetro = ```
			VAR vValor = [% Target Achievement]
			
			
			VAR vValor_formatado = FORMAT( vValor, "0%" ) 
			
			
			
			VAR vFator = -- Valor de rotação necessário para que o ponteiro saia do ponto ZERO e alcance o ponto CEM.
			    186
			
			VAR vRotacionar = 
			     ROUND( vValor * vFator , 0 ) 
			
			
			VAR vLimite_maximo =  -- Valor limite para evitar que o ponteiro ultrapasse o ponto máximo.
			    262 
			
			VAR vRotacionar_ajustado = 
			    IF( 
			        vRotacionar <= vLimite_maximo, 
			        vRotacionar, 
			        vLimite_maximo 
			    ) 
			
			
			
			---------------------------------------------
			-- FORMATAÇÕES 
			---------------------------------------------
			
			VAR vFonte = "Cambria"
			
			VAR vRot_categoria = "Target %"
			
			VAR vRotulo_dados_tam = 30
			VAR vRotulo_dados_cor = [Meta Cor] 
			
			VAR vCor_seta = vRotulo_dados_cor 
			
			VAR vMarcador_comum_cor  = "#9A9FA4" 
			
			VAR vMarcador_max_cor  = vRotulo_dados_cor 
			
			VAR vNumeros_cor = "#9A9FA4"
			
			------------------------------------------
			
			VAR vPrefixo = "data:image/svg+xml, "
			
			RETURN 
			
			"
			<svg  viewBox='0 0 250 200' fill='none' xmlns='http://www.w3.org/2000/svg'>
			
			        <defs>
			
			            <style>
			                #ponteiro {
			
			                    transform: rotate(" & vRotacionar_ajustado & "deg);
			                    transform-origin: center;
			                    transform-box: fill-box;
			
			                    animation: anima_ponteiro .7s linear forwards
			                }
			
			                @keyframes anima_ponteiro {
			
			                    from{ transform: rotate(0) }
			
			                    to { transform: rotate(" & vRotacionar_ajustado & "deg) }
			
			                }
			
			
			       
			            </style> 
			
			        </defs>
				
				
					<g id='marcadores'>
						<path id='marcador' fill-rule='evenodd' clip-rule='evenodd' d='M128.452 22.0096L127.904 22L127.745 31.131L128.293 31.1406L128.452 22.0096ZM123.671 22.0219L123.123 22.041L123.442 31.1679L123.989 31.1488L123.671 22.0219ZM118.897 22.2858L118.351 22.3335L119.147 31.4312L119.693 31.3835L118.897 22.2858ZM113.601 22.874L114.143 22.7977L115.414 31.8413L114.872 31.9175L113.601 22.874ZM109.423 23.5596L108.885 23.6642L110.628 32.6288L111.165 32.5242L109.423 23.5596ZM104.217 24.6987L104.749 24.5661L106.958 33.4273L106.426 33.5599L104.217 24.6987ZM100.134 25.8156L99.6099 25.9758L102.28 34.7092L102.804 34.549L100.134 25.8156ZM95.0758 27.4937L95.5907 27.3063L98.7141 35.888L98.1992 36.0754L95.0758 27.4937ZM91.1314 29.0312L90.6271 29.2453L94.1954 37.6517L94.6998 37.4376L91.1314 29.0312ZM86.2767 31.2287L86.7692 30.9885L90.7725 39.1967L90.2801 39.4369L86.2767 31.2287ZM82.5148 33.1713L82.0355 33.4369L86.463 41.4243L86.9423 41.1587L82.5148 33.1713ZM77.9159 35.8627L78.3806 35.5724L83.22 43.3171L82.7554 43.6075L77.9159 35.8627ZM74.378 38.1883L73.9292 38.5026L79.1673 45.9834L79.6162 45.6691L74.378 38.1883ZM70.0856 41.3457L70.5174 41.0084L76.1398 48.2048L75.708 48.5422L70.0856 41.3457ZM66.8098 44.0274L66.3963 44.3869L72.3877 51.2792L72.8012 50.9198L66.8098 44.0274ZM62.8713 47.6172L63.2654 47.2365L69.6093 53.8058L69.2152 54.1865L62.8713 47.6172ZM59.8939 50.6268L59.5202 51.0275L66.1992 57.2558L66.5729 56.8551L59.8939 50.6268ZM56.3522 54.6074L56.7044 54.1876L63.7002 60.0578L63.348 60.4776L56.3522 54.6074ZM53.7054 57.9119L53.3757 58.3495L60.6691 63.8456L60.9989 63.4079L53.7054 57.9119ZM50.5994 62.2433L50.9058 61.789L58.4769 66.8958L58.1705 67.3501L50.5994 62.2433ZM48.3126 65.8047L48.0304 66.2744L55.8584 70.9779L56.1406 70.5083L48.3126 65.8047ZM45.676 70.4357L45.9332 69.9519L53.9967 74.2393L53.7394 74.7231L45.676 70.4357ZM43.7743 74.2181L43.5427 74.7148L51.8195 78.5743L52.051 78.0777L43.7743 74.2181ZM41.6362 79.099L41.8414 78.591L50.3089 82.012L50.1036 82.5201L41.6362 79.099ZM40.1399 83.05