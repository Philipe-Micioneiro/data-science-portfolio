	measure 'Narr P4 Cidade' = "The city with the highest revenue is " & [Leading City] & "."
		displayFolder: 09 Narrativa P4 Carteira
		lineageTag: 8a2e033a-0aa0-4234-897d-724cc92d060b

	measure 'Narr P4 Meta' = FORMAT([Clients Below Target Count], "0", "en-US") & " clients are below 100% of their monthly target — a direct commercial action opportunity via BEES."
		displayFolder: 09 Narrativa P4 Carteira
