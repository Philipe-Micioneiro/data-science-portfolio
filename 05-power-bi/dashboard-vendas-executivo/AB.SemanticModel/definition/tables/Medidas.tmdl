		displayFolder: 11 Velocimetro
		lineageTag: 24db1b22-e1cb-403b-be71-8e29e9ae7e66

	measure 'Meta Cor' =
			VAR v = [% Target Achievement]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(v), "#9A9FA4",
			    v < 0.5, "#E2685A",
			    v < 1, "#F2A73B",
			    "#5FBE86"
			)
		displayFolder: 11 Velocimetro
		lineageTag: 54b73fe0-3b72-4239-ad7e-5b8931e20fc3

	/// Use no Colors > fx > Format by field value do gráfico de barras/colunas mensal (Total Revenue por mes). Pinta em destaque a barra do mes com maior faturamento dentro do que estiver filtrado; o resto fica cinza neutro.
	measure 'Best Month Bar Color' =
			VAR MonthRank =
			    RANKX(
			        ALL(D_Calendar[Month Year]),
			        CALCULATE([Total Revenue]),
			        ,
			        DESC
			    )
			RETURN
			    IF(MonthRank = 1, "#E0AE55", "#3A4250")
		displayFolder: 12 Chart Formatting
		lineageTag: c2c39deb-ca12-4058-a6f8-62e5c8ac0947

	/// Subrotulo de detalhe para o grafico de colunas mensal (Total Revenue por mes). Mostra a variacao MoM daquele mes com sinal explicito. Usar em Formatar visual > Rotulos de dados > Rotulos de detalhe.
	measure 'MoM Label Text' =
			VAR v = [Month-over-month growth (%)]
			RETURN
			    IF(ISBLANK(v), BLANK(), FORMAT(v, "+0.0%;-0.0%", "en-US"))
		displayFolder: 12 Chart Formatting
		lineageTag: aa37be83-a905-40b5-b69b-170e2a4eb330

	/// Cor condicional para o subrotulo MoM Label Text: verde se crescimento, vermelho se queda, cinza se em branco.
	measure 'MoM Label Color' =
			VAR v = [Month-over-month growth (%)]
			RETURN
			    IF(ISBLANK(v), "#9A9FA4", IF(v >= 0, "#5FBE86", "#E2685A"))
		displayFolder: 12 Chart Formatting
		lineageTag: 6f1012f6-a09c-4d0d-9d7a-865102f2e1fa

	/// Titulo customizado do card de Total Revenue: variacao MoM com seta, adaptado do padrao YoY do usuario (nao ha ano anterior nos dados, usamos MoM).
	measure 'Total Revenue Card Title' =
			VAR vPercMoM = [MoM (Último Mês)]
			RETURN
			    FORMAT(vPercMoM + 0, "⮝ +0.0% vs Previous Month; ⮟ -0.0% vs Previous Month; no change", "en-US")
		displayFolder: 13 Card Titles
		lineageTag: 594b42c7-32db-4aa6-96c2-4ca608335417

	/// Subtitulo customizado: mes com maior faturamento no periodo, mesmo padrao TOPN + ALL multi-coluna do usuario.
	measure 'Total Revenue Card Subtitle' =
			VAR BestMonthTable =
			    TOPN(
			        1,
			        ALL(D_Calendar[Month Abbrev], D_Calendar[Month Name], D_Calendar[Month Number]),
			        [Total Revenue],
			        DESC
			    )
			VAR BestMonthScalar = MAXX(BestMonthTable, D_Calendar[Month Abbrev])
			RETURN
			    "(" & BestMonthScalar & ") best month"
		displayFolder: 13 Card Titles
		lineageTag: ee772072-7724-4fc9-8da7-4f87d80e4e5a

	/// Cor condicional do titulo: verde se MoM positivo, vermelho se negativo, cinza se sem variacao.
	measure 'Total Revenue Card Title Color' =
			VAR vPercMoM = [MoM (Último Mês)]
			RETURN
			    SWITCH(
			        TRUE(),
			        vPercMoM > 0, "#5FBE86",
			        vPercMoM < 0, "#E2685A",
			        "#9A9FA4"
			    )
		displayFolder: 13 Card Titles
		lineageTag: 3c523df0-176b-485b-b469-e487fbba1019

	measure 'Average Ticket MoM %' =
			VAR CurrentVal = [Average Ticket]
			VAR PreviousVal = CALCULATE([Average Ticket], DATEADD(D_Calendar[Date], -1, MONTH))
			RETURN DIVIDE(CurrentVal - PreviousVal, PreviousVal, BLANK())
		isHidden
		displayFolder: 13 Card Titles
		lineageTag: a1c90d57-9598-4e4a-ae26-2a4403ed00d8

	measure 'Average Ticket MoM (Last Month)' =
			IF(
			    HASONEVALUE(D_Calendar[Year Month Number]),
			    [Average Ticket MoM %],
			    VAR LastMonthInContext = CALCULATE(MAX(D_Calendar[Year Month Number]), ALLSELECTED(D_Calendar))
			    RETURN CALCULATE([Average Ticket MoM %], D_Calendar[Year Month Number] = LastMonthInContext)
			)
		isHidden
		displayFolder: 13 Card Titles
		lineageTag: eb55e52e-a538-4edf-adf6-2322a46f2f08

	measure 'Average Ticket Card Title' =
			VAR v = [Average Ticket MoM (Last Month)]
			RETURN FORMAT(v + 0, "⮝ +0.0% vs Previous Month; ⮟ -0.0% vs Previous Month; no change", "en-US")
		displayFolder: 13 Card Titles
		lineageTag: cae8cd17-9e75-418f-acaa-5e230282fe9f

	measure 'Average Ticket Card Title Color' =
			VAR v = [Average Ticket MoM (Last Month)]
			RETURN SWITCH(TRUE(), v > 0, "#5FBE86", v < 0, "#E2685A", "#9A9FA4")
		displayFolder: 13 Card Titles
		lineageTag: 79ad977e-4168-42e6-b1d3-957754c6097d

	measure 'Average Ticket Card Subtitle' =
			VAR BestTable =
			    TOPN(
			        1,
			        ALL(D_Calendar[Month Abbrev], D_Calendar[Month Name], D_Calendar[Month Number]),
			        [Average Ticket],
			        DESC
			    )
			VAR BestScalar = MAXX(BestTable, D_Calendar[Month Abbrev])
			RETURN "(" & BestScalar & ") highest ticket"
		displayFolder: 13 Card Titles
		lineageTag: 92f6ed8a-170c-4142-a9e5-f16af6b535a8

	measure 'YTD Last Month Share %' =
			VAR LastMonthNum = CALCULATE(MAX(D_Calendar[Year Month Number]), ALLSELECTED(D_Calendar))
			VAR LastMonthRevenue = CALCULATE([Total Revenue], D_Calendar[Year Month Number] = LastMonthNum)
			VAR YTD = [Year-to-date revenue]
			RETURN DIVIDE(LastMonthRevenue, YTD, BLANK())
		isHidden
		displayFolder: 13 Card Titles
		lineageTag: 538acc09-7e5b-4299-961b-c3f6ad4128ec

	measure 'YTD Card Title' =
			VAR v = [YTD Last Month Share %]
			RETURN FORMAT(v, "0.0%", "en-US") & " from last month alone"
		displayFolder: 13 Card Titles
		lineageTag: 85c97094-83f0-4d7b-8b25-ffc1a8ad6fcb

	measure 'YTD Card Title Color' =
			VAR v = [YTD Last Month Share %]
			RETURN SWITCH(TRUE(), v >= 0.5, "#E2685A", v >= 0.3, "#F2A73B", "#5FBE86")
		displayFolder: 13 Card Titles
		lineageTag: fcc52c84-67be-4ee1-9479-2955c63bde3e

	measure 'YTD Card Subtitle' = "(" & FORMAT([Months In Context], "0") & " months tracked)"
		displayFolder: 13 Card Titles
		lineageTag: 13ab1ae5-78a3-435d-beb2-ad8c886fe331

	measure 'Clients On Target Count' = [Active Clients] - [Clients Below Target Count]
		isHidden
		displayFolder: 13 Card Titles
		lineageTag: 44703cdd-c04c-4fcc-873f-d7ac23646699

	measure 'Target Achievement Card Title' = FORMAT([Clients On Target Count], "0") & " of " & FORMAT([Active Clients], "0") & " clients on target"
		displayFolder: 13 Card Titles
		lineageTag: c2b9f7b1-e9eb-40ab-b6fe-b305be9fe6f2

	measure 'Target Achievement Card Title Color' =
			VAR OnTarget = [Clients On Target Count]
			RETURN SWITCH(TRUE(), OnTarget = [Active Clients], "#5FBE86", OnTarget = 0, "#E2685A", "#F2A73B")
		displayFolder: 13 Card Titles
		lineageTag: 92f5fcf1-4aa2-4d11-9a61-b39006e2d00f

	measure 'Target Achievement Card Subtitle' =
			VAR Gap = MAX([Total Period Target] - [Total Revenue], 0)
			RETURN "(" & FORMAT(Gap, "R$ #,##0", "en-US") & " to close gap)"
		displayFolder: 13 Card Titles
		lineageTag: 2c05f54b-2c3a-460c-aae9-75c1ab06adda

	measure 'Average MoM %' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month]), "@MoM", CALCULATE([Month-over-month growth (%)]))
			VAR Filtered = FILTER(MonthsTable, NOT ISBLANK([@MoM]))
			RETURN AVERAGEX(Filtered, [@MoM])
		isHidden
		displayFolder: 13 Card Titles
		lineageTag: 80a9dd66-ae1b-4294-89c2-a22476e07711

	measure 'MoM Card Title' =
			VAR CurrentMoM = [MoM (Último Mês)]
			VAR AvgMoM = [Average MoM %]
			RETURN IF(CurrentMoM >= AvgMoM, "⮝ above average pace", "⮟ below average pace")
		displayFolder: 13 Card Titles
		lineageTag: 92622755-5e82-4957-89b2-830cdf59c78f

	measure 'MoM Card Title Color' =
			VAR CurrentMoM = [MoM (Último Mês)]
			VAR AvgMoM = [Average MoM %]
			RETURN IF(CurrentMoM >= AvgMoM, "#5FBE86", "#E2685A")
		displayFolder: 13 Card Titles
		lineageTag: 7f1ca63a-3437-4df2-b635-59aee551b79a

	measure 'MoM Card Subtitle' = "(worst: " & [Worst MoM Month Name] & " " & FORMAT([Worst MoM Value], "0.0%", "en-US") & ")"
		displayFolder: 13 Card Titles
		lineageTag: e1975f79-6bfd-464b-937f-33fb7e8fc526

	/// Titulo dinamico do grafico com toggle (Toggle Metrica v2). Muda conforme a opcao selecionada na segmentacao de dados ligada ao Field Parameter.
	measure 'Toggle Chart Title' =
			SWITCH(
			    SELECTEDVALUE('Toggle Metrica v2'[Toggle Metrica v2 Campos]),
			    NAMEOF('Medidas'[Total Revenue]), "Total Revenue Metric",
			    NAMEOF('Medidas'[Month-over-month growth (%)]), "MoM Metric",
			    "Metric"
			)
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: 6e12d1ff-8863-40d9-b148-2df7bc38f519

	measure 'Target Gap Amount' = MAX([Total Period Target] - [Total Revenue], 0)
		isHidden
		displayFolder: 10 Narrativa P5 Conclusao
		lineageTag: 5b394de7-c5e1-41e8-9444-a67e682b7ed6

	/// Use no Colors > fx > Format by field value do grafico Top 5 products (eixo product_id). Pinta so o produto de maior receita, resto cinza.
	measure 'Top 5 Products Bar Color' =
			VAR ProductRank =
			    RANKX(
			        ALL(D_items[product_id]),
			        CALCULATE([Total Revenue]),
			        ,
			        DESC
			    )
			RETURN
			    IF(ProductRank = 1, "#E0AE55", "#3A4250")
		displayFolder: 12 Chart Formatting
		lineageTag: c8a9d642-dcab-47d0-808a-c6bd001043fb

	/// Use no Colors > fx > Format by field value do grafico Total Revenue por category (eixo D_items[category]). Pinta so a categoria de maior receita, resto cinza.
	measure 'Category Bar Color' =
			VAR CategoryRank =
			    RANKX(
			        ALL(D_items[category]),
			        CALCULATE([Total Revenue]),
			        ,
			        DESC
			    )
			RETURN
			    IF(CategoryRank = 1, "#E0AE55", "#3A4250")
		displayFolder: 12 Chart Formatting
		lineageTag: 3d648fb0-6eb5-419f-aef7-f0ce4169a8ad

	measure 'Positive MoM Months' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month]), "@MoM", CALCULATE([Month-over-month growth (%)]))
			RETURN COUNTROWS(FILTER(MonthsTable, [@MoM] > 0))
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: 31fd9aa7-ef9b-433e-bae3-17e7a82c10f2

	measure 'Negative MoM Months' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month]), "@MoM", CALCULATE([Month-over-month growth (%)]))
			RETURN COUNTROWS(FILTER(MonthsTable, [@MoM] < 0))
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: 4e3f98a8-214d-4db1-908a-ecc730b74853

	measure 'NAB Share %' = DIVIDE(CALCULATE([Total Revenue], D_items[category] = "nab"), [Total Revenue], BLANK())
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: 3ead22ad-545c-4378-83f9-86019759fe83

	measure 'Liquor Soda Share %' = DIVIDE(CALCULATE([Total Revenue], D_items[category] IN {"liquor","soda"}), [Total Revenue], BLANK())
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: 1a7a5cf0-91fb-4304-ac6e-7e44ca26ebb0

	measure 'Leading City Top Client Share %' =
			VAR TopCity = [Leading City]
			VAR CityRevenue = CALCULATE([Total Revenue], D_users[city] = TopCity)
			VAR ClientsInCity = CALCULATETABLE(VALUES(D_users[user_id]), D_users[city] = TopCity)
			VAR WithRev = ADDCOLUMNS(ClientsInCity, "@Rev", CALCULATE([Total Revenue]))
			VAR TopClientRevenue = MAXX(WithRev, [@Rev])
			RETURN DIVIDE(TopClientRevenue, CityRevenue, BLANK())
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: c766f288-a13f-487e-99b8-f75e872414f6

	measure 'Narr P2 Consistency' = "Growth was inconsistent across the year: only " & FORMAT([Positive MoM Months],"0","en-US") & " of the " & FORMAT([Positive MoM Months] + [Negative MoM Months],"0","en-US") & " comparable months showed month-over-month growth, with declines outnumbering gains " & FORMAT([Negative MoM Months],"0","en-US") & " to " & FORMAT([Positive MoM Months],"0","en-US") & "."
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: a310436b-0f12-444b-a7ad-7d3ddd4dfd86

	measure 'Narr P3 Mix' = "Beyond Beer's growth is really a NAB story: non-alcoholic alone represents " & FORMAT([NAB Share %],"0.0%","en-US") & " of revenue exposure, while liquor and soda combined stay under " & FORMAT([Liquor Soda Share %],"0.0%","en-US") & "."
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: 04df73b7-5365-484d-be35-754972cf4631

	measure 'Narr P4 Geography' = "" & [Leading City] & "'s lead is driven largely by a single client: its top account alone represents " & FORMAT([Leading City Top Client Share %],"0.0%","en-US") & " of the city's total revenue."
		displayFolder: 09 Narrativa P4 Carteira
		lineageTag: a6538905-ff63-40e0-b36f-c87eff10712a

	column ' '
		formatString: 0
		lineageTag: 47b5223a-09ba-4d2e-9903-2aa61640f152
		summarizeBy: sum
		isNameInferred
		sourceColumn: [ ]

		annotation SummarizationSetBy = Automatic

