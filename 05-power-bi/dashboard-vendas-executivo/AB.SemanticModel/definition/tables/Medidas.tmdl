table Medidas
	lineageTag: ee7ec310-c1e1-4276-a0f6-a297c6b30fdc

	measure 'Total Revenue' = SUMX(VALUES(F_orders[order_id]), CALCULATE(MAX(F_orders[revenue])))
		formatString: R$ #,##0.00
		displayFolder: 01 KPIs Principais
		lineageTag: 2687a1aa-0e25-4476-9f4b-612a0db5094f

	measure 'Order Count' = DISTINCTCOUNT(F_orders[order_id])
		formatString: #,##0
		displayFolder: 01 KPIs Principais
		lineageTag: 18f78c1f-becd-4081-ac27-ef3b3c8f4d83

	measure 'Active Clients' = DISTINCTCOUNT(F_orders[user_id])
		formatString: #,##0
		displayFolder: 01 KPIs Principais
		lineageTag: 3406ac1a-f617-4c4a-8264-1b53dd3afc0f

	measure 'Average Ticket' = DIVIDE([Total Revenue], DISTINCTCOUNT(F_orders[order_id]), 0)
		formatString: R$ #,##0.00
		displayFolder: 01 KPIs Principais
		lineageTag: 0935c65a-6087-419b-b0f9-b1eb44b9dd9c

	measure 'Month-over-month growth (%)' =
			VAR RevenueCurrentMonth = [Total Revenue]
			VAR RevenuePreviousMonth = CALCULATE([Total Revenue], DATEADD(D_Calendar[Date], -1, MONTH))
			RETURN DIVIDE(RevenueCurrentMonth - RevenuePreviousMonth, RevenuePreviousMonth, BLANK())
		formatString: 0.0%;-0.0%
		displayFolder: 01 KPIs Principais
		lineageTag: 2849fa48-6199-4efb-854e-3e169b1b0d11

	measure 'Year-to-date revenue' = TOTALYTD([Total Revenue], D_Calendar[Date])
		formatString: R$ #,##0.00
		displayFolder: 01 KPIs Principais
		lineageTag: 7a19fc64-9bd7-4fc8-a745-407719ce7042

	/// Nota metodológica: revenue está no grau do pedido (repetido em cada linha de item), não há preço/quantidade por SKU. Este ranking reflete a receita de pedidos que contém cada produto (exposição de receita), não uma quebra exata de faturamento por SKU. Pedidos multi-produto são contados em mais de um produto.
	measure 'Top 5 products' = CALCULATE([Total Revenue], KEEPFILTERS(TOPN(5, ALL(D_items[product_id]), CALCULATE([Total Revenue]), DESC)))
		formatString: R$ #,##0.00
		displayFolder: 01 KPIs Principais
		lineageTag: dc930e8c-38a6-4477-830b-dc1349723ddb

	measure 'Total Monthly Target' = SUM(D_targets[monthly revenue target])
		formatString: R$ #,##0.00
		displayFolder: 02 Metas (BEES)
		lineageTag: bf69328c-db5b-494c-b048-5ef224eb247b

	measure '% Target Achievement' = DIVIDE([Total Revenue], [Total Period Target], BLANK())
		formatString: 0.0%;-0.0%
		displayFolder: 02 Metas (BEES)
		lineageTag: c68fa473-9d00-4a8e-b7d2-ff0da33a21b0

	measure 'Clients Below Target Count' = COUNTROWS(FILTER(VALUES(D_users[user_id]), [% Target Achievement] < 1))
		formatString: #,##0
		displayFolder: 02 Metas (BEES)
		lineageTag: 9dcef784-9ed7-4421-98c8-c95832d1e968

	/// Receita de pedidos que contêm ao menos um produto Beyond Beer (nab/liquor/soda). Pedidos multi-categoria também contam em Beer, por isso a soma das categorias pode superar o Total Revenue. Métrica de exposição de receita, não uma quebra exata por categoria.
	measure 'Beyond Beer Revenue' = CALCULATE([Total Revenue], D_items[category] IN {"nab","liquor","soda"})
		formatString: R$ #,##0.00
		displayFolder: 03 Portfolio
		lineageTag: 4831e3d4-140e-4059-a64c-f06ba0940278

	/// % dos pedidos (por receita) que envolvem ao menos um produto Beyond Beer. Ver nota em [Beyond Beer Revenue] sobre sobreposição entre categorias.
	measure '% Beyond Beer Share' = DIVIDE([Beyond Beer Revenue], [Total Revenue], BLANK())
		formatString: 0.0%;-0.0%
		displayFolder: 03 Portfolio
		lineageTag: 2765534c-f2b9-495b-bf88-5ce8456e8ac1

	measure 'Leading Product Category' =
			VAR TopCat = TOPN(1, ALL(D_items[category]), CALCULATE([Total Revenue]), DESC)
			RETURN CALCULATE(SELECTEDVALUE(D_items[category]), TopCat)
		displayFolder: 03 Portfolio
		lineageTag: 31a01417-668f-4d57-ad78-aabec0a511f7

	measure 'Top Product ID' =
			VAR TopP = TOPN(1, ALL(D_items[product_id]), CALCULATE([Total Revenue]), DESC)
			RETURN CALCULATE(SELECTEDVALUE(D_items[product_id]), TopP)
		displayFolder: 03 Portfolio
		lineageTag: eed769c9-56f1-4068-8967-560d00dc1f98

	measure 'Leading City' =
			VAR TopCity = TOPN(1, ALL(D_users[city]), CALCULATE([Total Revenue]), DESC)
			RETURN CALCULATE(SELECTEDVALUE(D_users[city]), TopCity)
		displayFolder: 04 Cliente
		lineageTag: 5b17cc81-16ed-42bd-90d1-2dc18a99a615

	measure 'Leading Client Category' =
			VAR TopSeg = TOPN(1, ALL(D_users[category]), CALCULATE([Total Revenue]), DESC)
			RETURN CALCULATE(SELECTEDVALUE(D_users[category]), TopSeg)
		displayFolder: 04 Cliente
		lineageTag: 8c2c0cfa-63dd-4e72-a7d3-b6cdf1985deb

	measure 'Best Month Name' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month], D_Calendar[Month Year]), "@Rev", CALCULATE([Total Revenue]))
			VAR TopMonth = TOPN(1, MonthsTable, [@Rev], DESC)
			RETURN MAXX(TopMonth, D_Calendar[Month Year])
		displayFolder: 05 Apoio Narrativa
		lineageTag: d826c073-5f9a-40fa-b8b5-bf45c202cc84

	measure 'Best Month Revenue' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month]), "@Rev", CALCULATE([Total Revenue]))
			RETURN MAXX(MonthsTable, [@Rev])
		formatString: R$ #,##0.00
		displayFolder: 05 Apoio Narrativa
		lineageTag: 003802ed-9fce-4cde-844b-b2c460a32405

	measure 'Worst MoM Month Name' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month], D_Calendar[Month Year]), "@MoM", CALCULATE([Month-over-month growth (%)]))
			VAR Filtrado = FILTER(MonthsTable, NOT ISBLANK([@MoM]))
			VAR BottomMonth = TOPN(1, Filtrado, [@MoM], ASC)
			RETURN MAXX(BottomMonth, D_Calendar[Month Year])
		displayFolder: 05 Apoio Narrativa
		lineageTag: 7a2808ce-a3c7-4bc2-8b9c-037025bd6aaf

	measure 'Worst MoM Value' =
			VAR MonthsTable = ADDCOLUMNS(SUMMARIZE(ALL(D_Calendar), D_Calendar[Year Month]), "@MoM", CALCULATE([Month-over-month growth (%)]))
			VAR Filtrado = FILTER(MonthsTable, NOT ISBLANK([@MoM]))
			RETURN MINX(Filtrado, [@MoM])
		formatString: 0.0%;-0.0%
		displayFolder: 05 Apoio Narrativa
		lineageTag: 87a98b27-0068-4180-8337-3d779ec00314

	measure 'Months In Context' = DISTINCTCOUNT(D_Calendar[Year Month])
		isHidden
		displayFolder: 02 Metas (BEES)
		lineageTag: 8edf0bfc-3b3a-4431-8c02-12d58758a116

	measure 'Total Period Target' = [Total Monthly Target] * [Months In Context]
		formatString: R$ #,##0.00
		displayFolder: 02 Metas (BEES)
		lineageTag: e3ba3c20-a145-4964-8123-81bc2ece7e88

	measure 'Top 2 Clients Share' =
			VAR ClientTable = ADDCOLUMNS(VALUES(D_users[user_id]), "@Rev", CALCULATE([Total Revenue]))
			VAR Top2 = TOPN(2, ClientTable, [@Rev], DESC)
			VAR Top2Revenue = SUMX(Top2, [@Rev])
			RETURN DIVIDE(Top2Revenue, [Total Revenue], BLANK())
		formatString: 0.0%
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: 8fd759a8-ec88-4ae5-a660-a887255db8a5

	measure 'Raw Revenue No Dedup' = SUM(F_orders[revenue])
		formatString: R$ #,##0.00
		isHidden
		displayFolder: 05 Apoio Narrativa
		lineageTag: a3fbf535-c971-40cc-93eb-6cb68a35b420

	measure 'Narr P1 Faturamento' = "Total revenue for the period is " & FORMAT([Total Revenue], "R$ #,##0.00", "en-US") & ", with an average ticket of " & FORMAT([Average Ticket], "R$ #,##0.00", "en-US") & " per order."
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: b4dbbcd7-cb09-40a3-b99d-30b5021e9d47

	measure 'Narr P1 Crescimento' = "Month-over-month growth (last closed month) is at " & FORMAT([MoM (Último Mês)], "0.0%", "en-US") & "."
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: eebbec16-f448-4adb-a61c-bbd80e038e83

	measure 'Narr P1 YTD' = "Year-to-date accumulated revenue reaches " & FORMAT([Year-to-date revenue], "R$ #,##0.00", "en-US") & "."
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: ca11febe-4d80-40fd-845b-38b5592e9c8d

	measure 'Narr P1 Meta' = "The portfolio reached " & FORMAT([% Target Achievement], "0.0%", "en-US") & " of the defined monthly target, with " & FORMAT([Clients Below Target Count], "0", "en-US") & " clients still below objective."
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: 84dc7e0e-2707-467b-999d-9db217e769c9

	measure 'Narr P1 Operacao' = "The operation counts " & FORMAT([Active Clients], "0", "en-US") & " active clients and " & FORMAT([Order Count], "#,##0", "en-US") & " orders processed."
		displayFolder: 06 Narrativa P1 Panorama
		lineageTag: 67bbbf06-eefe-4c3a-bdd8-d41fe252db0b

	measure 'Narr P2 MelhorMes' = "The best-performing month was " & [Best Month Name] & ", with revenue of " & FORMAT([Best Month Revenue], "R$ #,##0.00", "en-US") & "."
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: 22987a08-6343-42c7-922f-faf33b4c71d5

	measure 'Narr P2 PiorMes' = "The largest month-over-month drop occurred in " & [Worst MoM Month Name] & ", with a decline of " & FORMAT([Worst MoM Value], "0.0%", "en-US") & "."
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: 4544e936-2769-4fe2-bc28-94fd5f88e4d7

	measure 'Narr P2 YTD' = "Year-to-date revenue represents " & FORMAT([Year-to-date revenue], "R$ #,##0.00", "en-US") & " — use the controls alongside to switch between absolute and percentage views."
		displayFolder: 07 Narrativa P2 Evolucao
		lineageTag: 12ff0a04-6062-41dd-86b5-349d085ae350

	measure 'Narr P3 Categoria' = "The " & [Leading Product Category] & " category leads portfolio revenue."
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: e9dd2792-a6ec-4630-bc5d-18a42cdcd788

	measure 'Narr P3 BeyondBeer' = "Beyond Beer categories (non-alcoholic, spirits and soft drinks) account for " & FORMAT([% Beyond Beer Share], "0.0%", "en-US") & " of revenue — the BEES strategic diversification frontier."
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: bbe04e20-dd8a-455a-8ed8-ac866dc7ea87

	measure 'Narr P3 TopSKU' = "The top-earning SKU is product " & FORMAT([Top Product ID], "0", "en-US") & ", featured in the period's Top 5."
		displayFolder: 08 Narrativa P3 Portfolio
		lineageTag: 970e59f4-53c3-4e77-98df-328a6e1e521d

	measure 'Narr P4 Segmento' = "The " & [Leading Client Category] & " segment generates the most revenue in the portfolio."
		displayFolder: 09 Narrativa P4 Carteira
